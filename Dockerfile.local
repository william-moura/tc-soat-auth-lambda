FROM node:20-alpine

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install

# Instala o express temporariamente para simular o API Gateway em Dev
RUN npm install express

COPY . .

# Criar um entrypoint local simples
RUN echo "const express = require('express'); const { handler } = require('./src/index'); const app = express(); app.use(express.json()); app.post('/auth', async (req, res) => { const event = { body: JSON.stringify(req.body) }; const result = await handler(event); res.status(result.statusCode).send(JSON.parse(result.body)); }); app.listen(3000, () => console.log('Lambda Auth rodando na porta 3000'));" > server.js

EXPOSE 3000

CMD ["node", "server.js"]